# ───────── VeloDrive API (server/) ─────────
API_PORT=5000
# Where Next.js forwards /api/* (used by next.config.mjs rewrites)
API_URL=http://localhost:5000
# Public site URL (email links point here)
CLIENT_URL=http://localhost:3000

MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/cars?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Gmail: 2-Step Verification → App password. Leave empty to print emails in the terminal.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# SMTP_SECURE is worked out from the port (465 = SSL, 587 = STARTTLS)
SMTP_USER=
SMTP_PASS=
MAIL_FROM="VeloDrive <no-reply@velodrive.com.au>"

ADMIN_NAME=Site Admin
ADMIN_EMAIL=admin@velodrive.com.au
ADMIN_PASSWORD=Admin@12345
SEED_ON_START=true
