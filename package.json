{
  "name": "carrental",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n web,api -c magenta,cyan \"next dev\" \"node --watch server/index.js\"",
    "dev:web": "next dev",
    "dev:api": "node --watch server/index.js",
    "build": "next build",
    "start": "concurrently -n web,api \"next start\" \"node server/index.js\"",
    "start:api": "node server/index.js",
    "seed": "node server/seed/seed.js",
    "lint": "eslint"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "framer-motion": "^14.0.0",
    "gsap": "^3.15.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "lenis": "^1.1.13",
    "lucide-react": "^1.53.0",
    "mongoose": "^8.8.1",
    "morgan": "^1.10.0",
    "next": "16.4.0",
    "nodemailer": "^6.9.16",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "concurrently": "^9.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4"
  }
